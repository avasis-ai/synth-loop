{
  "name": "@avasis-ai/synth-loop",
  "version": "1.0.0",
  "description": "The AI that upgrades itself. Recursive self-improvement loop for any open-source project.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "bin": {
    "synth-loop": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "self-improving",
    "recursive",
    "bootstrapping",
    "autonomous",
    "open-source",
    "upgrade",
    "synth",
    "loop",
    "claude-code",
    "aider",
    "coding-agent",
    "viral",
    "ouroboros"
  ],
  "license": "MIT",
  "author": "Avasis AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avasis-ai/synth-loop.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@avasis-ai/synthcode": ">=1.0.0"
  }
}
